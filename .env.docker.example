# Environment for compose.yml (copied from compose.example.yml).
# Copy this file to .env (git-ignored) and replace every placeholder.
# For every other supported variable, see .env.example.

# Required. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Database credentials (the database is only reachable inside the Docker network).
POSTGRES_USER=sure_user
POSTGRES_PASSWORD=
POSTGRES_DB=sure_production

# Encrypts provider credentials stored in the database. Set all three or none.
# Generate each with: openssl rand -hex 32
# Keep these stable: changing them makes stored provider credentials unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Host port for the web UI (bound to 127.0.0.1 only).
PORT=3000

# Optional: OpenAI-compatible API for AI features.
OPENAI_ACCESS_TOKEN=
